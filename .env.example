# Demo-only values — never use in production. Copy to `.env` and keep `.env` untracked.

POSTGRES_USER=hub
POSTGRES_PASSWORD=hub
POSTGRES_DB=hub
DATABASE_URL=postgresql+asyncpg://hub:hub@localhost:5432/hub
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Demo-only Fernet key — generate for prod:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=5_WV7MVo7J1c7rG_fvokHN5XBw9XQ2exZ3JvRbTsb4I=

# Demo-only admin bootstrap token (also HS256 JWT stub secret)
ADMIN_BOOTSTRAP_TOKEN=demo-admin-bootstrap-token-not-for-prod

# Grafana demo login — never use in production
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

LOG_LEVEL=INFO

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=partner-integration-hub-api
OTEL_SDK_DISABLED=false

# Appendix A — hub tuning defaults
HUB_MAX_ATTEMPTS_DEFAULT=8
HUB_BACKOFF_BASE_SECONDS=30
HUB_BACKOFF_MULTIPLIER=2
HUB_BACKOFF_MAX_SECONDS=3600
HUB_INBOUND_TIMESTAMP_TOLERANCE=300
HUB_HTTP_CONNECT_TIMEOUT_MS=3000
HUB_HTTP_READ_TIMEOUT_MS=10000
HUB_IDEMPOTENCY_TTL_HOURS=24
HUB_CIRCUIT_FAILURE_THRESHOLD=10
HUB_CIRCUIT_WINDOW_SECONDS=60
HUB_CIRCUIT_OPEN_SECONDS=300
HUB_RATE_LIMIT_RPS_DEFAULT=100
HUB_SECRET_ROTATION_OVERLAP_HOURS=24
HUB_SLA_SECONDS_DEFAULT=60
HUB_DLQ_AGE_ALERT_SECONDS=3600
# Host/pytest default. Compose hub-api overrides this to true.
HUB_REPLAY_APPROVAL_REQUIRED=false

# Load-test knobs (export in the shell; scripts do not source this file)
# LOAD_HOST=http://127.0.0.1:8000
# LOAD_ADMIN_TOKEN=   # optional override of ADMIN_BOOTSTRAP_TOKEN
# LOAD_PARTNER_SLUG=acme-erp
# LOAD_PARTNER_PUBLIC_ID=  # optional; otherwise resolved via Admin API after seed
# LOAD_USERS=2
# LOAD_SPAWN_RATE=1
# LOAD_RUN_TIME=10s
# LOAD_WAIT_MIN=0.1
# LOAD_WAIT_MAX=0.5
